PORT=3001
NODE_ENV=development

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=paramo_libre

JWT_SECRET=cambia_esto_en_produccion

# Clave compartida con el Arduino / gateway del estante (header X-Shelf-Key)
SHELF_API_KEY=clave_secreta_del_sensor

# ------------------------------------------------------------
# Biblioteca Inteligente 4.0 — compañero de lectura (LLM)
# Crea o completa server/.env con estas variables. No pegues
# aquí la clave real: este archivo es solo la plantilla.
#
# LLM_PROVIDER   openai | gemini
# LLM_API_KEY    clave del proveedor elegido (obligatoria para el modelo real)
# LLM_MODEL      opcional. openai: gpt-4o-mini | gemini: gemini-2.0-flash
# OPENAI_API_KEY alias si LLM_PROVIDER=openai y LLM_API_KEY está vacío
# GEMINI_API_KEY alias si LLM_PROVIDER=gemini y LLM_API_KEY está vacío
# OPENAI_BASE_URL opcional, por defecto https://api.openai.com/v1
#
# Sin ninguna clave, POST /api/comprehension/evaluate sigue el guion
# socrático en local para poder probar la interfaz.
# ------------------------------------------------------------
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
